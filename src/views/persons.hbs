{{> navbar}}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Personas</h1>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#personModal" id="btnNewPerson">
            Nueva persona
        </button>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>E-mail</th>
                <th>Telefono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="personsTableBody">
            <!-- filas se insertan por JS -->
        </tbody>
    </table>
</div>

{{> person-form-modal}}

